<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>roslynk</AssemblyName>
		<RootNamespace>Morris.Roslynk.Cli</RootNamespace>
		<RollForward>LatestMajor</RollForward>
		<!-- The 'roslynk' command: the operation routes, the served daemon ('serve') and the MCP stdio host in one Nuru app. -->
		<IsPackable>true</IsPackable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>roslynk</ToolCommandName>
		<PackageId>Roslynk</PackageId>
		<!-- CI overrides Version from the release tag; this is only the local-build fallback. -->
		<Version>0.0.1-local</Version>
		<Description>Roslynk: C# semantic intelligence over Roslyn, as an MCP server and a command line. Run 'dnx Roslynk -- stdio' as an MCP stdio command (it self-starts a shared local server), or 'roslynk --capabilities' for the commands.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/mrpmorris/Roslynk</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mrpmorris/Roslynk</RepositoryUrl>
		<PackageTags>mcp;roslyn;csharp;model-context-protocol;cli</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- The app is a mediator graph member, so Nuru dispatches each [Operation] through the generated
		     mediator to the handler registered for it (Handlers/), in the served daemon, or in this process when a call opts out of forwarding. -->
		<TimeWarpMediatorAssembly>true</TimeWarpMediatorAssembly>
		<InterceptorsNamespaces>$(InterceptorsNamespaces);TimeWarp.Nuru.Generated</InterceptorsNamespaces>
	</PropertyGroup>

	<!--
		The [Operation] request classes are compiled here as linked sources: Nuru discovers endpoints only in
		the compiling project's own syntax (timewarp-nuru 508-013 would lift this). The engine is referenced under
		the 'engine' alias, so its copies of the same types never meet these.
		Every Features/**/*.cs file except the MCP tool classes (*Tool.cs) and the batch catalog is an
		operation contract or a type one of them declares; the Infrastructure files are their whole closure.
		A new feature file that is not Roslyn-free must be added to the Exclude list (see AGENTS.md).
	-->
	<ItemGroup>
		<Compile Include="..\Morris.Roslynk\Features\**\*.cs"
			Exclude="..\Morris.Roslynk\Features\**\*Tool.cs;..\Morris.Roslynk\Features\MultiQuery\MultiQueryCatalog.cs"
			Link="Contracts\Features\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Morris.Roslynk\Infrastructure\Operations\IOutlineResponse.cs" Link="Contracts\Infrastructure\Operations\IOutlineResponse.cs" />
		<Compile Include="..\Morris.Roslynk\Infrastructure\Operations\OutlineHeader.cs" Link="Contracts\Infrastructure\Operations\OutlineHeader.cs" />
		<Compile Include="..\Morris.Roslynk\Infrastructure\Operations\ProblemOutline.cs" Link="Contracts\Infrastructure\Operations\ProblemOutline.cs" />
		<Compile Include="..\Morris.Roslynk\Infrastructure\Documentation\ParameterDescriptions.cs" Link="Contracts\Infrastructure\Documentation\ParameterDescriptions.cs" />
		<Compile Include="..\Morris.Roslynk\Infrastructure\Outlines\OutlineDescriptions.cs" Link="Contracts\Infrastructure\Outlines\OutlineDescriptions.cs" />
	</ItemGroup>

	<!--
		The engine, under an alias so its copies of the contract types never meet the linked ones above. Only
		Handlers/ and Hosting/RoslynkEngine.cs name it, and only from methods that run where a handler runs (the
		served daemon, or this process when a call opts out of forwarding), so a forwarded call or the capabilities listing never loads Roslyn.
	-->
	<ItemGroup>
		<ProjectReference Include="..\Morris.Roslynk\Morris.Roslynk.csproj" Aliases="engine" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Morris.Roslynk.Cli.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="TimeWarp.Nuru" />
		<PackageReference Include="TimeWarp.Nuru.Daemon" />
		<PackageReference Include="TimeWarp.Nuru.McpHost" />
		<PackageReference Include="TimeWarp.Contracts" />
		<!-- The served daemon exports the engine's traces and metrics when OTEL_EXPORTER_OTLP_ENDPOINT is set. -->
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
	</ItemGroup>

</Project>
