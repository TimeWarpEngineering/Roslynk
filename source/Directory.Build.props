<Project>

	<!-- RepositoryRoot (and the other repository paths) for the package icon below. -->
	<Import Project="$(MSBuildThisFileDirectory)../msbuild/repository.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Authors>Peter Morris</Authors>
		<Company>Peter Morris</Company>
		<Copyright>Peter Morris</Copyright>
		<PackageIcon>logo.png</PackageIcon>
		<PackageProjectUrl>https://timewarp.software/projects/Roslynk/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/TimeWarpEngineering/Roslynk</RepositoryUrl>
	</PropertyGroup>

	<!--
		TimeWarp release flow (task 008): the fork's package version is typed once, here. `dev release` tags
		v{Version}, and CI packs TimeWarp.Roslynk at it. Only projects that opt in are packable (today
		Morris.Roslynk.Cli), so the dev CLI's derived package set is exactly the one tool package.
	-->
	<PropertyGroup Label="Release">
		<Version>1.0.0-beta.1</Version>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup Label="Package Content">
		<None Include="$(RepositoryRoot)assets/logo.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
